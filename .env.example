# ===== Discord =====
# 개발자 포털에서 발급한 봇 토큰. 절대 커밋하지 말 것.
DISCORD_TOKEN=
# 봇이 동작할 서버 ID (명령어를 이 서버에만 등록)
GUILD_ID=
# 이 역할 보유자 = 회원 (역할 부여 시 자동 등록, 회수 시 비활성화)
MEMBER_ROLE_ID=
# 이 역할 보유자 = 관리자
ADMIN_ROLE_ID=
# 관리자 검토 요청이 올라갈 채널 (관리자 전용 채널 권장)
ADMIN_CHANNEL_ID=
# 주간 리포트가 게시될 공개 채널
REPORT_CHANNEL_ID=
# (선택) /인증을 이 채널에서만 허용. 비워두면 모든 채널 허용
VERIFICATION_CHANNEL_ID=

# ===== Database =====
# 로컬 실행 기준. docker compose의 bot 서비스는 이 값을 db 호스트로 덮어쓴다.
DATABASE_URL=postgresql+asyncpg://gym:gym@localhost:5432/gym
# docker compose의 PostgreSQL 계정 (운영 시 반드시 변경)
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym
POSTGRES_DB=gym
POSTGRES_PORT=5432

# ===== 정책 =====
# club_policy가 비어 있을 때 넣는 초기 주간 목표 (1~7)
INITIAL_WEEKLY_TARGET=4
# 텍스트만 제출할 때 공백 제외 최소 글자 수
TEXT_MIN_LENGTH=10
# 이미지 최대 용량 (bytes, 기본 10MB)
IMAGE_MAX_BYTES=10485760
# 유사 이미지로 판단할 pHash 해밍 거리 (작을수록 엄격하게 같은 사진만 잡음)
PHASH_DISTANCE_THRESHOLD=4
# 이미지 저장 위치와 판정 후 보관 일수
IMAGE_DIR=./data/images
IMAGE_RETENTION_DAYS=30
# 주간 리포트 게시 시각 (KST, 시)
REPORT_HOUR=9

# ===== 기타 =====
LOG_LEVEL=INFO

# ===== 테스트 =====
# 통합 테스트용 DB. 없으면 자동으로 만든다 (DATABASE_URL과 다른 DB를 쓸 것)
TEST_DATABASE_URL=postgresql+asyncpg://gym:gym@localhost:5432/gym_test
